{
  "name": "JobHunter private Python workspace",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "forwardPorts": [
    8765
  ],
  "portsAttributes": {
    "8765": {
      "label": "JobHunter \u2014 keep this port private",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  },
  "postCreateCommand": "python -m pip install -r requirements-scanners.lock",
  "postStartCommand": "bash .devcontainer/start.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
